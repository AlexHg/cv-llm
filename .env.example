# Backend Open Responses (el agente y /v1/responses lo usan para generar)
OPEN_RESPONSES_URL=https://api.openai.com/v1/responses
OPEN_RESPONSES_API_KEY=your_open_responses_api_key
OPEN_RESPONSES_MODEL=gpt-4o-mini

# Clave para que otros sistemas llamen a este agente
INTERNAL_API_KEY=replace_with_a_long_random_secret
